pipeline{
    agent any
    tools{
        maven 'maven-3.9'
        jdk 'jdk-21'
    }
    environment{
        REGISTRY = 'sunnytyagi13'
        IMAGE = 'ecommerce-orders'
        SONARQUBE_ENV = 'sonarqube-server'
        TAG = "${BUILD_NUMBER}"
        DOCKER_HOST = 'unix:///var/run/docker.sock'
        TESTCONTAINERS_RYUK_DISABLED = 'true'
    }
    stages{
        stage ('Checkoutcode'){
            steps {
                git branch: 'main',
                    url: 'https://github.com/sunny008-ux/k8s-microservices-ecommerce-app.git'
            }
        }

        stage ('Build & Test'){
            steps {
                dir ('src/orders') {
                    sh '''
                    export DOCKER_HOST=unix:///var/run/docker.sock
                    export TESTCONTAINERS_RYUK_DISABLED=true

                    mvn clean test \
                      -Dtestcontainers.host.override=unix:///var/run/docker.sock
                    '''
                }
            }
        }

    // SonarQube- Quality check

        stage ('Code Quality Check'){
            steps {
                dir ('src/orders'){
                    withSonarQubeEnv("${SONARQUBE_ENV}") {
                        sh """
                        mvn sonar:sonar \
                          -Dsonar.projectKey=ecommerce-orders \
                          -Dsonar.projectName=ecommerce-orders
                        """ 
                    }
                }
            }

        }

        stage ('BUILD IMAGE') {
            steps {
                dir ('src/orders'){
                    sh "docker build -t ${REGISTRY}/${IMAGE}:${TAG} ."
                }
            }
        }

        stage ('Security - Trivy Scan') {
            steps {
                sh """
                trivy image --exit-code 1 --severity HIGH,CRITICAL \
                  ${REGISTRY}/${IMAGE}:${TAG}
                """
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-token',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push ${REGISTRY}/${IMAGE}:${TAG}
                    """
                }
            }
        }

            
    }

}